# Définition des scalars personnalisés
scalar UUID
scalar DateTime
scalar Long


# Type Photo
type LogementPhoto {
    id: UUID!
    logementId: UUID!
    fileName: String!
    contentType: String!
    photoDataUrl: String
    createdAt: DateTime!
}

# Énumération pour StatutValidation
enum StatutValidation {
    EN_ATTENTE
    VALIDE
    REJETE
}

# Type Logement
type Logement {
    id: UUID!
    titre: String!
    description: String
    adresse: String!
    type: String!
    prix: Float!
    latitude: Float
    longitude: Float
    nombreChambres: Int
    nombreCuisines: Int
    nombreSallesBain: Int
    nombreToilettes: Int
    disponible: Boolean!
    proprietaireId: UUID!
    statutValidation: StatutValidation!
    dateCreation: DateTime!
}

type LogementDto {
    id: UUID!
    titre: String!
    description: String
    adresse: String!
    type: String!
    prix: Float!
    latitude: Float
    longitude: Float
    nombreChambres: Int
    nombreCuisines: Int
    nombreSallesBain: Int
    nombreToilettes: Int
    disponible: Boolean!
    proprietaireId: UUID!
    statutValidation: StatutValidation!
    dateCreation: DateTime!
    photos: [LogementPhoto!]!
    photoCount: Int!
}

type LogementResponse {
    id: UUID!
    titre: String!
    description: String
    adresse: String!
    type: String!
    prix: Float!
    latitude: Float
    longitude: Float
    nombreChambres: Int
    nombreCuisines: Int
    nombreSallesBain: Int
    nombreToilettes: Int
    disponible: Boolean!
    proprietaireId: UUID!
    statutValidation: String
    dateCreation: DateTime!
    photos: [LogementPhoto!]!
    photoCount: Int!
}

# Input pour la création d'un logement
input LogementCreateInput {
    titre: String!
    description: String
    adresse: String!
    type: String!
    prix: Float!
    latitude: Float
    longitude: Float
    nombreChambres: Int
    nombreCuisines: Int
    nombreSallesBain: Int
    nombreToilettes: Int
    disponible: Boolean!
    proprietaireId: UUID!
}

# Input pour la mise à jour d'un logement
input LogementUpdateInput {
    titre: String
    description: String
    adresse: String
    type: String
    prix: Float
    latitude: Float
    longitude: Float
    nombreChambres: Int
    nombreCuisines: Int
    nombreSallesBain: Int
    nombreToilettes: Int
    disponible: Boolean
}

# Input pour la validation/rejet d'un logement
input LogementValidationInput {
    id: UUID!
    statutValidation: StatutValidation!
}

# Type Query
type Query {
    # Récupérer un logement par ID
    getById(id: UUID!): LogementDto

    # Récupérer tous les logements
    getAll: [LogementDto!]!

    # Rechercher des logements par ville
    searchByVille(ville: String!): [LogementDto!]!

    # Rechercher des logements par type
    searchByType(type: String!): [LogementDto!]!

    # Rechercher des logements par plage de prix
    searchByPrix(min: Float, max: Float): [LogementDto!]!

    # Rechercher des logements par disponibilité
    searchDisponible(disponible: Boolean!): [LogementDto!]!

    # Récupérer les logements en attente de validation
    getEnAttente: [LogementDto!]!

    # Récupérer les logements d'un propriétaire
    getByProprietaireId(proprietaireId: UUID!): [LogementDto!]!

    # Récupérer les logements d'un utilisateur propriétaire
    getLogementsByUtilisateurId(utilisateurId: UUID!): [LogementDto!]!

    # Récupérer les logements du propriétaire connecté côté frontend
    mesLogements(utilisateurId: UUID!): [LogementDto!]!

    # Récupérer toutes les photos d'un logement
    getLogementPhotos(logementId: UUID!): [LogementPhoto!]!

    # Récupérer une photo spécifique
    getPhotoById(photoId: UUID!, logementId: UUID!): LogementPhoto

    # Compter les photos d'un logement
    countLogementPhotos(logementId: UUID!): Long!
}

# Type Mutation
type Mutation {
    # Créer un nouveau logement
    create(input: LogementCreateInput!): LogementDto!

    # Mettre à jour un logement
    mettreAJourLogement(id: UUID!, input: LogementUpdateInput!): LogementDto!

    # Supprimer un logement
    supprimerLogement(id: UUID!): Boolean!

    # Valider un logement
    validerLogement(id: UUID!): LogementDto!

    # Rejeter un logement
    rejeterLogement(id: UUID!): LogementDto!

    # Upload de photos pour un logement (max 4 photos)
    uploadLogementPhotos(logementId: UUID!, files: [Upload!]!): [LogementPhoto!]!

    # Upload de photos pour un logement et retourne le logement avec ses photos
    uploadHousePhotos(houseId: UUID!, files: [Upload!]!): LogementResponse!

    # Supprimer une photo spécifique
    deleteLogementPhoto(photoId: UUID!, logementId: UUID!): Boolean!

    # Supprimer toutes les photos d'un logement
    deleteAllLogementPhotos(logementId: UUID!): Boolean!
}
