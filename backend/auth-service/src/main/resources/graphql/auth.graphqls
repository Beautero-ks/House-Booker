# ============================================================
# auth.graphqls
# ============================================================

# ─────────────────────────────────────────────────────────────
# TYPES DE RÉPONSE
# ─────────────────────────────────────────────────────────────

type AuthResponse {
    success:      Boolean!
    message:      String!
    accessToken:  String
    refreshToken: String
    user:         UserInfo
}
type UserInfo {
    id:          String!
    name:        String!
    email:       String!
    username:    String
    phoneNumber: String
    photoUrl:    String
    isVerified:  Boolean!
    enabled:     Boolean!
    role:        String
    provider:    String
    updatedAt:   String
    createdAt:   String
}
type UserResponse {
    success: Boolean!
    message: String!
    user:    UserInfo
}

type UsersResponse {
    success: Boolean!
    message: String!
    users:   [UserInfo]
    total:   Int
}
type UserPage {
    items:         [UserInfo!]!
    page:          Int!
    size:          Int!
    totalElements: Int!
    totalPages:    Int!
}


# ─────────────────────────────────────────────────────────────
# INPUTS
# ─────────────────────────────────────────────────────────────

"""
Données requises pour l'inscription d'un nouvel utilisateur.
Après inscription :
  1. Un access token et refresh token sont générés
  2. Un OTP à 6 chiffres est généré (expire dans 10 minutes)
  3. L'event Kafka 'notificationUser.created' est publié
  4. Le Notification-Service envoie l'OTP par mail
"""
input RegisterInput {
    name:        String!
    email:       String!
    password:    String!
    phoneNumber: String!
}

input LoginInput {
    email:    String!
    password: String!
}

input VerifyOtpInput {

    """
    Identifiant UUID de l'utilisateur.
    Récupéré dans le champ notificationUser.id de la réponse du register.
    """
    userId: String!
    code:   String!
}

input RefreshTokenInput {
    refreshToken: String!
}

input GoogleAuthInput {
    idToken: String!
}

# ─────────────────────────────────────────────────────────────
# INPUTS USER
# ─────────────────────────────────────────────────────────────
input UpdateProfileInput {
    name:        String
    username:    String
    email:       String
    phoneNumber: String
    photoUrl:    String
}

input ChangePasswordInput {
    currentPassword: String!
    newPassword:     String!
}

input DeleteAccountInput {
    currentPassword: String
    otpCode: String
}

input AssignRoleInput {
    userId: String!
    role:   String!
}

input RemoveRoleInput {
    userId: String!
}

# ─────────────────────────────────────────────────────────────
# QUERY
# ─────────────────────────────────────────────────────────────

type Query {
    healthCheck:    String!
    getCurrentUser: UserInfo
    getUserById(id: String!): UserInfo
    getUsers(page: Int, size: Int): UserPage
}

# ─────────────────────────────────────────────────────────────
# MUTATIONS
# ─────────────────────────────────────────────────────────────

type Mutation {
    register(input: RegisterInput!):         AuthResponse!
    verifyOtp(input: VerifyOtpInput!):       AuthResponse!
    login(input: LoginInput!):               AuthResponse!
    refreshToken(input: RefreshTokenInput!): AuthResponse!

    """
    Renvoi d'un nouveau code OTP quand l'ancien a expiré.

    Flux :
      1. Vérifie que le compte existe et n'est pas encore vérifié
      2. Invalide tous les anciens OTPs de cet utilisateur
      3. Génère un nouveau OTP à 6 chiffres (valable 10 minutes)
      4. Republie l'event Kafka 'notificationUser.created' avec le nouvel OTP
           → Notification-Service renvoie le mail avec le nouveau code
      5. Retourne un message de confirmation

    Erreurs possibles :
      - "Ce compte est déjà vérifié" (BAD_REQUEST)
      - "Utilisateur introuvable" (NOT_FOUND)
    """
    resendOtp(userId: String!):              AuthResponse!
    googleLogin(input: GoogleAuthInput!):    AuthResponse!

    # User management
    updateProfile(input: UpdateProfileInput!):   UserInfo!
    changePassword(input: ChangePasswordInput!): AuthResponse!
    deleteAccount(input: DeleteAccountInput!):   AuthResponse!
    assignRole(input: AssignRoleInput!):         UserInfo!
    removeRole(userId: String!):                 UserInfo!
    blockUser(userId: String!):                  UserInfo!
    unblockUser(userId: String!):                UserInfo!
    deleteUserByAdmin(userId: String!):          AuthResponse!
}
