# ============================================================
# auth.graphqls
# ============================================================

# ─────────────────────────────────────────────────────────────
# TYPES DE RÉPONSE
# ─────────────────────────────────────────────────────────────

type AuthResponse {
    success:      Boolean!
    message:      String!
    accessToken:  String
    refreshToken: String
    user:         UserInfo
}

type UserInfo {
    id:          String!
    name:        String!
    email:       String!
    phoneNumber: String
    isVerified:  Boolean!
    role:        String
    createdAt:   String
}

# ─────────────────────────────────────────────────────────────
# INPUTS
# ─────────────────────────────────────────────────────────────

input RegisterInput {
    name:        String!
    email:       String!
    password:    String!
    phoneNumber: String!
}

input LoginInput {
    email:    String!
    password: String!
}

input VerifyOtpInput {
    userId: String!
    code:   String!
}

input RefreshTokenInput {
    refreshToken: String!
}

input GoogleAuthInput {
    idToken: String!
}

# ─────────────────────────────────────────────────────────────
# QUERY
# ─────────────────────────────────────────────────────────────

type Query {
    healthCheck: String!
}

# ─────────────────────────────────────────────────────────────
# MUTATIONS
# ─────────────────────────────────────────────────────────────

type Mutation {
    register(input: RegisterInput!):         AuthResponse!
    verifyOtp(input: VerifyOtpInput!):       AuthResponse!
    login(input: LoginInput!):               AuthResponse!
    refreshToken(input: RefreshTokenInput!): AuthResponse!
    resendOtp(userId: String!):              AuthResponse!
    googleLogin(input: GoogleAuthInput!):   AuthResponse!
}
